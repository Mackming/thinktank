# ==============================================================================
# ThinkTank Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Mode Configuration
# Provide keys below to run ThinkTank in high-speed, headless API Mode.
# If no keys are provided, ThinkTank defaults to Browser Mode (local web sessions).
# ------------------------------------------------------------------------------

# --- DeepSeek ---
# Official portal: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Qwen (Alibaba Cloud DashScope) ---
# Official portal: https://dashscope.console.aliyun.com
# Accepts either DASHSCOPE_API_KEY or QWEN_API_KEY
DASHSCOPE_API_KEY=
QWEN_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# --- GLM / Zhipu AI (BigModel) ---
# Official portal: https://open.bigmodel.cn
# Accepts either ZHIPUAI_API_KEY or GLM_API_KEY
ZHIPUAI_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# --- Universal Fallbacks (Optional) ---
# If you prefer to use a single provider for all 3 agents:

# OpenRouter (https://openrouter.ai):
# Automatically maps deepseek -> deepseek/deepseek-chat, qwen -> qwen/qwen-2.5-72b-instruct, glm -> thudm/glm-4-9b-chat
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com):
# Automatically maps agents to OpenAI models if specific agent keys are absent
OPENAI_API_KEY=
